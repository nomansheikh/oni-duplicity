// Cloudflare Workers static assets: the built app is served as-is, with no Worker script.
// Deployed by the `deploy` job in .github/workflows/release.yml. By hand, after `vp run -r build`:
// `vp exec wrangler deploy` from this folder.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oni-duplicity",
  "compatibility_date": "2026-10-15",
  "assets": {
    // Vite's build output; headers come from public/_headers, copied in by the build.
    "directory": "./dist",
  },
  // One public URL: the custom domain. Cloudflare creates its DNS record and certificate on deploy.
  "routes": [{ "pattern": "oni.noman.codes", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
}
