# Cloudflare Workers static assets header rules (not served as a file).
# Everything else keeps the default `public, max-age=0, must-revalidate` with an ETag.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite names these by content hash, so they never change under the same URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
